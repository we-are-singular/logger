{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.cache/**",
    "**/.build/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/package-lock.json",
    "**/CHANGELOG.md"
  ],
  "overrides": [
    {
      "files": ["*.json"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
