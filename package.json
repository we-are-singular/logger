{
  "name": "@we-are-singular/logger",
  "version": "2.1.3",
  "description": "Fast, immutable Pino v10 logger wrapper for Node.js, NestJS, and Fastify",
  "homepage": "https://github.com/we-are-singular/logger#readme",
  "bugs": {
    "url": "https://github.com/we-are-singular/logger/issues"
  },
  "license": "MIT",
  "author": "singular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-are-singular/logger.git"
  },
  "files": [
    ".build/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./.build/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./.build/index.d.mts",
        "default": "./.build/index.mjs"
      },
      "require": {
        "types": "./.build/index.d.cts",
        "default": "./.build/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./.build/nestjs.d.mts",
        "default": "./.build/nestjs.mjs"
      },
      "require": {
        "types": "./.build/nestjs.d.cts",
        "default": "./.build/nestjs.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./.build/fastify.d.mts",
        "default": "./.build/fastify.mjs"
      },
      "require": {
        "types": "./.build/fastify.d.cts",
        "default": "./.build/fastify.cjs"
      }
    }
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "tsc --noEmit && oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run --exclude \"test/smoke/**\"",
    "test:watch": "vitest --exclude \"test/smoke/**\"",
    "test:coverage": "vitest run --coverage --exclude \"test/smoke/**\"",
    "test:smoke": "vitest run test/smoke",
    "build": "tsdown",
    "check:pkg": "publint --strict",
    "prepare": "husky",
    "release": "release-it"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/common": "^12.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "fastify": "^5.12.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "publint": "^0.3.25",
    "release-it": "^21.1.3",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "git pull -r",
        "npm run format:check",
        "npm run lint",
        "npm run test",
        "npm run build",
        "npm run test:smoke",
        "npm run check:pkg"
      ],
      "after:bump": "npx auto-changelog -p"
    },
    "git": {
      "requireBranch": "main",
      "commitMessage": "release: ${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true
    }
  }
}
